{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "authentication": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
        },
        "credentials": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e](?:[\\x20-\\x7e]*[\\x21-\\x7e])?$"
        }
      },
      "required": [
        "scheme",
        "credentials"
      ],
      "additionalProperties": false
    },
    "token": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  },
  "required": [
    "authentication"
  ],
  "additionalProperties": false
}
