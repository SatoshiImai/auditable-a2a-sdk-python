{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "last": {
      "description": "The host-assigned fields of an a-MCP accept (a-MCP §7.1), or null.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "host_ts": {
              "format": "date-time",
              "type": "string",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?Z$"
            },
            "previous_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "record_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "log_id": {
              "type": "string",
              "minLength": 1
            },
            "host_signature": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "host_key_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "seq",
            "host_ts",
            "previous_hash",
            "record_hash"
          ],
          "additionalProperties": false,
          "dependentRequired": {
            "log_id": [
              "host_signature",
              "host_key_id"
            ],
            "host_signature": [
              "log_id",
              "host_key_id"
            ],
            "host_key_id": [
              "log_id",
              "host_signature"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "last"
  ],
  "additionalProperties": false
}
