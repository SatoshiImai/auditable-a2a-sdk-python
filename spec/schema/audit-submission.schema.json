{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "event": {
      "description": "One Auditable MCP audit event, valid against a-MCP's audit-event.schema.json (auditable-mcp/0.4).",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "position": {
      "type": "boolean",
      "const": true
    },
    "close": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "taskId"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "event"
      ]
    },
    {
      "required": [
        "position"
      ]
    },
    {
      "required": [
        "close"
      ]
    }
  ]
}
