{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attemptId": {
      "type": "string",
      "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|00000000-0000-0000-0000-000000000000)$"
    },
    "execution": {
      "type": "string",
      "enum": [
        "not-performed",
        "indeterminate"
      ]
    }
  },
  "required": [
    "attemptId",
    "execution"
  ],
  "additionalProperties": false
}
